generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  EDITOR
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

model AdminUser {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique @db.VarChar(191)
  passwordHash String
  role         UserRole  @default(EDITOR)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  newsPosts NewsPost[]
  events    Event[]

  @@index([role, isActive])
}

model SiteSettings {
  id             Int      @id @default(autoincrement())
  siteName       String   @default("راك فالمـرسى")
  tagline        String?  @db.VarChar(500)
  logoMediaId    Int?
  heroMediaId    Int?
  phone          String?  @db.VarChar(50)
  email          String?  @db.VarChar(191)
  address        String?  @db.VarChar(500)
  workingHours   String?  @db.VarChar(500)
  facebookUrl    String?  @db.VarChar(500)
  instagramUrl   String?  @db.VarChar(500)
  youtubeUrl     String?  @db.VarChar(500)
  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  logoMedia Media? @relation("SiteLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  heroMedia Media? @relation("SiteHero", fields: [heroMediaId], references: [id], onDelete: SetNull)
}

model Media {
  id           Int      @id @default(autoincrement())
  storageKey   String   @unique @db.VarChar(500)
  originalName String?  @db.VarChar(255)
  altText      String?  @db.VarChar(500)
  mimeType     String   @db.VarChar(100)
  sizeBytes    Int?
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  siteLogos SiteSettings[] @relation("SiteLogo")
  siteHeros SiteSettings[] @relation("SiteHero")
  placeCovers Experience[]  @relation("ExperienceCover")
  experienceCovers TouristPlace[] @relation("TouristPlaceCover")
  newsCovers NewsPost[] @relation("NewsCover")
  eventCovers Event[] @relation("EventCover")
  placeGallery TouristPlaceMedia[]
  experienceGallery ExperienceMedia[]
}

model TouristPlace {
  id          Int           @id @default(autoincrement())
  name        String
  slug        String        @unique @db.VarChar(191)
  shortText   String?       @db.VarChar(500)
  description String?       @db.Text
  address     String?       @db.VarChar(500)
  latitude    Decimal?      @db.Decimal(10, 7)
  longitude   Decimal?      @db.Decimal(10, 7)
  status      PublishStatus @default(DRAFT)
  featured    Boolean       @default(false)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  coverMediaId Int?
  coverMedia   Media?              @relation("TouristPlaceCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  gallery      TouristPlaceMedia[]

  @@index([status, featured, sortOrder])
}

model Experience {
  id          Int           @id @default(autoincrement())
  name        String
  slug        String        @unique @db.VarChar(191)
  shortText   String?       @db.VarChar(500)
  description String?       @db.Text
  status      PublishStatus @default(DRAFT)
  featured    Boolean       @default(false)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  coverMediaId Int?
  coverMedia   Media?             @relation("ExperienceCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  gallery      ExperienceMedia[]

  @@index([status, featured, sortOrder])
}

model NewsPost {
  id          Int           @id @default(autoincrement())
  title       String
  slug        String        @unique @db.VarChar(191)
  excerpt     String?       @db.VarChar(1000)
  content     String        @db.LongText
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  authorId    Int
  coverMediaId Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  author     AdminUser @relation(fields: [authorId], references: [id], onDelete: Restrict)
  coverMedia Media?    @relation("NewsCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
}

model Event {
  id          Int           @id @default(autoincrement())
  title       String
  slug        String        @unique @db.VarChar(191)
  excerpt     String?       @db.VarChar(1000)
  description String?       @db.Text
  location    String?       @db.VarChar(500)
  startsAt    DateTime
  endsAt      DateTime?
  status      PublishStatus @default(DRAFT)
  organizerId Int
  coverMediaId Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  organizer  AdminUser @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  coverMedia Media?    @relation("EventCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  @@index([status, startsAt])
}

model ContactMessage {
  id        Int           @id @default(autoincrement())
  fullName  String        @db.VarChar(191)
  email     String        @db.VarChar(191)
  subject   String        @db.VarChar(255)
  message   String        @db.Text
  status    MessageStatus @default(UNREAD)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

model TouristPlaceMedia {
  placeId Int
  mediaId Int
  sortOrder Int @default(0)

  place TouristPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)
  media Media        @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([placeId, mediaId])
  @@index([placeId, sortOrder])
}

model ExperienceMedia {
  experienceId Int
  mediaId      Int
  sortOrder    Int @default(0)

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  media      Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([experienceId, mediaId])
  @@index([experienceId, sortOrder])
}

model Session {
  id        String   @id @db.VarChar(191)
  sid       String   @unique @db.VarChar(191)
  data      String   @db.Text
  expiresAt DateTime

  @@index([expiresAt])
}
